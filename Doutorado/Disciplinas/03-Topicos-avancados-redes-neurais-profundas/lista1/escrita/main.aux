\@writefile{lof}{\contentsline {figure}{\numberline {13}{\ignorespaces Distribuição do número de imagens do conjunto UTKFace agrupadas por faixas etárias. Observa-se uma concentração de amostras em adultos jovens, principalmente entre 20 e 29 anos, enquanto as faixas etárias mais avançadas apresentam quantidade significativamente menor de exemplos.}}{14}{figure.caption.17}\protected@file@percent }
\newlabel{fig:data3}{{13}{14}{Distribuição do número de imagens do conjunto UTKFace agrupadas por faixas etárias. Observa-se uma concentração de amostras em adultos jovens, principalmente entre 20 e 29 anos, enquanto as faixas etárias mais avançadas apresentam quantidade significativamente menor de exemplos}{figure.caption.17}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {14}{\ignorespaces Arquitetura da rede neural convolucional utilizada para a regressão da idade. O modelo é composto por quatro blocos convolucionais para extração de características, seguidos por uma etapa de \textit  {Adaptive Average Pooling} e camadas totalmente conectadas que produzem uma única saída correspondente à idade estimada.}}{15}{figure.caption.18}\protected@file@percent }
\newlabel{fig:model3}{{14}{15}{Arquitetura da rede neural convolucional utilizada para a regressão da idade. O modelo é composto por quatro blocos convolucionais para extração de características, seguidos por uma etapa de \textit {Adaptive Average Pooling} e camadas totalmente conectadas que produzem uma única saída correspondente à idade estimada}{figure.caption.18}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {15}{\ignorespaces Evolução da função de custo durante o treinamento dos quatro modelos avaliados. Os modelos M3 e M4 apresentam valores mais elevados devido à inclusão do termo de regularização por consistência na função objetivo.}}{17}{figure.caption.19}\protected@file@percent }
\newlabel{fig:train3}{{15}{17}{Evolução da função de custo durante o treinamento dos quatro modelos avaliados. Os modelos M3 e M4 apresentam valores mais elevados devido à inclusão do termo de regularização por consistência na função objetivo}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {16}{\ignorespaces Evolução do Erro Absoluto Médio (MAE) no conjunto de validação durante o treinamento dos modelos M1 (baseline), M2 (aumentação de dados), M3 (regularização de consistência) e M4 (combinação das duas estratégias). Observa-se uma redução progressiva do erro ao longo das épocas, com o modelo M4 apresentando os menores valores ao final do treinamento.}}{18}{figure.caption.20}\protected@file@percent }
\newlabel{fig:res3}{{16}{18}{Evolução do Erro Absoluto Médio (MAE) no conjunto de validação durante o treinamento dos modelos M1 (baseline), M2 (aumentação de dados), M3 (regularização de consistência) e M4 (combinação das duas estratégias). Observa-se uma redução progressiva do erro ao longo das épocas, com o modelo M4 apresentando os menores valores ao final do treinamento}{figure.caption.20}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {17}{\ignorespaces Valores finais de MAE e RMSE obtidos no conjunto de teste para os quatro modelos avaliados. O modelo M4 apresenta os menores valores para ambas as métricas, indicando melhor desempenho na tarefa de regressão da idade.}}{18}{figure.caption.21}\protected@file@percent }
\newlabel{fig:res32}{{17}{18}{Valores finais de MAE e RMSE obtidos no conjunto de teste para os quatro modelos avaliados. O modelo M4 apresenta os menores valores para ambas as métricas, indicando melhor desempenho na tarefa de regressão da idade}{figure.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {18}{\ignorespaces Exemplos de imagens do conjunto de teste. Para cada imagem são apresentados a idade real e as idades estimadas pelos modelos M1 (baseline), M2 (aumentação de dados), M3 (regularização de consistência) e M4 (combinação das duas estratégias).}}{19}{figure.caption.22}\protected@file@percent }
\newlabel{fig:res33}{{18}{19}{Exemplos de imagens do conjunto de teste. Para cada imagem são apresentados a idade real e as idades estimadas pelos modelos M1 (baseline), M2 (aumentação de dados), M3 (regularização de consistência) e M4 (combinação das duas estratégias)}{figure.caption.22}{}}
